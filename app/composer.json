{
    "name": "anymodule/agentmodule",
    "description": "Agent module for super documentation module",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Anymodule\\Agentmodule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anymodule\\Agentmodule\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "vasenin26"
        }
    ],
    "require": {
        "czproject/git-php": "^4.5",
        "monolog/monolog": "^3.9",
        "openai-php/client": "^0.16.0",
        "symfony/http-client": "^7.3",
        "nyholm/psr7": "^1.8",
        "guzzlehttp/guzzle": "^7.10",
        "ramsey/uuid": "^4.9"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "phpunit"
    }
}
